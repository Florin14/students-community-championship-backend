# --- Database ---------------------------------------------------------------
# Neon / any Postgres connection string, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require
# For a quick local smoke-test without Postgres you can use:
# DATABASE_URL=sqlite:///./scc.db
DATABASE_URL=

# --- App --------------------------------------------------------------------
APP_ENV=local
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (admin only) --------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Default admin seeded at startup if no admin exists
DEFAULT_ADMIN_EMAIL=admin@scc.ro
DEFAULT_ADMIN_PASSWORD=change-me
DEFAULT_ADMIN_NAME=Administrator
