# Every variable this repo reads - the application at runtime and the compose
# stack at start-up (CORE-023). Copy to `.env` and fill in; `.env` is untracked
# and never holds a value that also lives in CI.
#
#   cp .env.template .env
#
# Compose reads this same `.env` from the repo root, so one file configures both
# `uvicorn` from a checkout and `docker compose up`.

# === Application ============================================================

# --- Database ---------------------------------------------------------------
# The platform runs on Postgres. Paste the connection string exactly as the
# console shows it - `postgres://` and `postgresql://` are both accepted, and
# `sslmode=require` is added automatically for Neon / Supabase hosts.
#
#   Neon      DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/scc?sslmode=require
#   Supabase  DATABASE_URL=postgresql://postgres.<ref>:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#             (the "Session pooler" string: it works over IPv4; the direct
#             db.<ref>.supabase.co host is IPv6-only on most networks)
#
# Leave EMPTY when running the docker stack locally: env.yml then points the
# containers at the bundled `postgres` service.
DATABASE_URL=
# Connections held per API process. Managed Postgres counts connections, so
# keep pool_size x replicas well under the provider's limit (Neon: depends on
# compute size; Supabase: see the plan). Overflow connections are opened on
# demand and closed again.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Seconds to wait for a pooled connection / for the TCP connect.
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# --- App --------------------------------------------------------------------
APP_ENV=local
# Local convenience only: create tables at startup. MUST be false in
# every deployed environment - the schema is managed by Alembic there
# (the containers force it to false regardless of what is set here).
AUTO_CREATE_TABLES=true
PORT=8000
# Comma-separated list of browser origins allowed to call the API.
# In production add every deployed frontend origin, e.g.
# ALLOWED_ORIGINS=https://scc.example.ro,https://www.scc.example.ro
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------
# prod: set on the host (Render: generated once by render.yaml). The container
# refuses to start if this is still the compose placeholder while APP_ENV is
# not `local`.
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# First super-admin, seeded by the defaults step only when no administrator
# exists yet. Leave the password empty to skip seeding entirely - the right
# choice for a deployment whose administrator is created by hand.
DEFAULT_ADMIN_EMAIL=admin@scc.ro
DEFAULT_ADMIN_PASSWORD=change-me
DEFAULT_ADMIN_NAME=Administrator

# === Docker stack ===========================================================
# Read by docker-compose.yml / env.yml / local_db.yml / port_forwards.yml.

# Names the containers, the network and the volumes, so several environments can
# share one host without colliding: local / testing / staging / production.
ENV=local

# Image to run. Empty = build locally from this checkout and tag it
# students-community-championship-backend:${APP_VERSION}. A deployment sets the
# immutable tag produced by scripts/build-image.sh, e.g.
# API_IMAGE=registry.example.eu/scc/backend:sha-ab12cd3
API_IMAGE=
APP_VERSION=local

# Applied by the `migrate` job, so the API does not run them itself. Set to true
# only for a single-replica environment with no job step (Render free tier).
RUN_MIGRATIONS=false
LOG_LEVEL=INFO

# --- Tests ------------------------------------------------------------------
# A Postgres server the test harness may create databases on (any database in
# the URL, e.g. the maintenance one). Each test module creates its own database
# there and drops it afterwards. Unset = throwaway SQLite, which proves less.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/postgres

# --- Migrations and defaults ------------------------------------------------
# The `migrate` job brings the schema to head and then populates the default
# rows, in that order (src/services/run_migrations.py).

# true makes the job exit without touching the database. For a service that
# shares a database it does not own.
SKIP_MIGRATION=false

# Which callable populates the defaults once the schema is at head. It receives
# a session and returns True when every step succeeded. Same contract as the
# other platforms; only the module path follows this repo's layout.
DEFAULTS_POPULATE_FILE=services.populate_defaults
DEFAULTS_POPULATE_FUNCTION=populate_defaults

# --- Local-only Postgres (local_db.yml) -------------------------------------
POSTGRES_IMAGE=postgres:17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scc

# --- Published ports (port_forwards.yml) ------------------------------------
API_PORT=8000
# Not 5432: the host may already run a Postgres of its own.
POSTGRES_PORT=15432
